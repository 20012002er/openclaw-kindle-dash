# ===== OpenClaw 网关配置 =====
# OpenClaw Gateway 地址（本机部署则保持 127.0.0.1）
OPENCLAW_BASE_URL=http://127.0.0.1:18789
# OpenClaw 认证模式，对应 gateway.auth.mode 配置：
#   token         —— 用配置的 Gateway Token 认证
#   password      —— 用配置的 Gateway Password 认证
#   trusted-proxy —— 通过上游身份代理注入的 header 认证（本服务不直接支持，请选 none 并由代理处理）
#   none          —— 无需认证（仅限 loopback/私有网络）
OPENCLAW_AUTH_MODE=password
# 网关凭证（无用户名概念，只有一个共享 token 或 password）。
# 对应配置项 gateway.auth.token 或 gateway.auth.password。
# 不论 token 还是 password 模式，请求时都通过 Authorization: Bearer <值> 发送。
OPENCLAW_CREDENTIAL=your-gateway-password-or-token-here
# Usage API 端点路径（根据 OpenClaw 版本可能不同，请按实际情况修改）
OPENCLAW_USAGE_ENDPOINT=/api/usage
# 数据抓取模式：api | mock
#   api  —— 调用 OpenClaw REST API（默认）
#   mock —— 使用模拟数据，用于测试/开发
FETCH_MODE=api

# ===== 服务器配置 =====
PORT=3000
# 生成的 PNG 输出路径
OUTPUT_FILE=public/dash.png

# ===== 定时生成配置 =====
# cron 表达式，默认每 5 分钟生成一次
GENERATE_CRON=*/5 * * * *

# ===== Kindle 设备分辨率 =====
# KPW3 第7代 竖屏：1072 x 1448
# KPW3 第7代 横屏：1448 x 1072
SCREEN_WIDTH=1072
SCREEN_HEIGHT=1448

# ===== 截图配置 =====
# 页面加载后额外等待毫秒数，确保渲染完成
PAGE_RENDER_DELAY=1000
