# ===== OpenClaw 网关配置 =====
# 这些值是默认值；登录管理页面后可在「OpenClaw 网关连接」表单中覆盖。
# OpenClaw Gateway 地址（HTTP 或 HTTPS 均可，代码会自动转为 ws:// 或 wss://）。
# 使用 docker-compose.yml 默认的 network_mode: host 时，容器内 127.0.0.1
# 直接指向宿主机，无需 host.docker.internal。
OPENCLAW_BASE_URL=http://127.0.0.1:18789
# 认证方式：password | token | none
# 对应 gateway.auth.mode 配置。
OPENCLAW_AUTH_MODE=password
# 网关凭证（无用户名概念，只有一个共享 token 或 password）。
# password 模式对应 gateway.auth.password；token 模式对应 gateway.auth.token。
OPENCLAW_CREDENTIAL=your-gateway-password-or-token-here
# 数据抓取模式：api | mock
#   api  —— 通过 WebSocket RPC 调用 sessions.usage 和 usage.status（默认）
#   mock —— 使用空数据，用于测试/开发
FETCH_MODE=api

# ===== 服务器配置 =====
PORT=3000
# 生成的 PNG 输出路径
OUTPUT_FILE=public/dash.png

# ===== 定时生成配置 =====
# cron 表达式，默认每 5 分钟生成一次
GENERATE_CRON=*/5 * * * *

# ===== Kindle 设备分辨率 =====
# KPW3 第7代 竖屏：1072 x 1448
# KPW3 第7代 横屏：1448 x 1072
SCREEN_WIDTH=1072
SCREEN_HEIGHT=1448

# ===== 截图配置 =====
# 页面加载后额外等待毫秒数，确保渲染完成
PAGE_RENDER_DELAY=1000

# ===== 管理页面认证 =====
# 访问 /admin 管理页面所需的用户名和密码
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
# Session 加密密钥，建议改为随机字符串
SESSION_SECRET=change-me-to-a-random-string
