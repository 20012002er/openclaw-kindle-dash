# ===== OpenClaw 网关配置 =====
# OpenClaw Gateway 地址（HTTP 或 WS 均可，代码会自动转为 ws://）。
# 使用 docker-compose.yml 默认的 network_mode: host 时，容器内 127.0.0.1
# 直接指向宿主机，无需 host.docker.internal。
OPENCLAW_BASE_URL=http://127.0.0.1:18789
# 网关凭证（无用户名概念，只有一个共享 token 或 password）。
# 对应配置项 gateway.auth.token 或 gateway.auth.password。
# 通过 WebSocket connect 握手时以 auth.token 字段发送。
OPENCLAW_CREDENTIAL=your-gateway-password-or-token-here
# 数据抓取模式：api | mock
#   api  —— 通过 WebSocket RPC 调用 sessions.usage 和 usage.status（默认）
#   mock —— 使用空数据，用于测试/开发
FETCH_MODE=api

# ===== 服务器配置 =====
PORT=3000
# 生成的 PNG 输出路径
OUTPUT_FILE=public/dash.png

# ===== 定时生成配置 =====
# cron 表达式，默认每 5 分钟生成一次
GENERATE_CRON=*/5 * * * *

# ===== Kindle 设备分辨率 =====
# KPW3 第7代 竖屏：1072 x 1448
# KPW3 第7代 横屏：1448 x 1072
SCREEN_WIDTH=1072
SCREEN_HEIGHT=1448

# ===== 截图配置 =====
# 页面加载后额外等待毫秒数，确保渲染完成
PAGE_RENDER_DELAY=1000
